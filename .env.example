# Supabase → Project Settings → API Keys
# Only the project URL and the PUBLISHABLE key (sb_publishable_...) are needed.
# Do NOT put the secret key here. The app never uses it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Comma-separated list of emails allowed to use the app (the gym owner).
# Leave empty to allow any account that exists in your Supabase project.
OWNER_EMAILS=owner@example.com
